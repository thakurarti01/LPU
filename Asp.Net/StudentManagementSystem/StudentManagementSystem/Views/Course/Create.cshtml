@model StudentManagementSystem.Models.Course

<h2>Add Course</h2>

<form asp-action="Create">

	<div class="form-group">
		<label>Course Name</label>
		<input asp-for="CourseName" class="form-control" placeholder="Example: Web Development" />
	</div>

	<div class="form-group">
		<label>Course Duration</label>
		<input asp-for="Duration" class="form-control" placeholder="Example: 6 Months" />
	</div>

	<div class="form-group">
		<label>Course Fees</label>
		<input asp-for="Fees" class="form-control" placeholder="Example: 50000" />
	</div>

	<div class="form-group">
		<label>Select Department</label>
		<select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control"></select>
	</div>

	<br />

	<button type="submit" class="btn btn-primary">Add Course</button>

	<a asp-action="Index" class="btn btn-secondary">Back</a>

</form>