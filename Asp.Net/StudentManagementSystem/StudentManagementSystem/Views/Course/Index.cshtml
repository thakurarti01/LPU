@model IEnumerable<StudentManagementSystem.Models.Course>

<h2>Courses</h2>

<a asp-action="Create">Add Course</a>

<table class="table">

	<tr>
		<th>Name</th>
		<th>Duration</th>
		<th>Fees</th>
		<th>Department</th>
		<th>Actions</th>
	</tr>

	@foreach (var c in Model)
	{
		<tr>
			<td>@c.CourseName</td>
			<td>@c.Duration</td>
			<td>@c.Fees</td>
			<td>@c.Department.DepartmentName</td>

			<td>
				<a asp-action="Edit" asp-route-id="@c.CourseId">Edit</a> |
				<a asp-action="Delete" asp-route-id="@c.CourseId">Delete</a>
			</td>
		</tr>
	}

</table>