@model StudentManagementSystem.Models.Department

<h2>Add Department</h2>

<form asp-action="Create">

	<div class="form-group">
		<label>Department Name</label>
		<input asp-for="DepartmentName" class="form-control" placeholder="Example: Computer Science" />
	</div>

	<div class="form-group">
		<label>Department Description</label>
<textarea asp-for="Description" class="form-control" placeholder="Brief description about department"></textarea>
	</div>

	<br />

	<button type="submit" class="btn btn-primary">Add Department</button>

	<a asp-action="Index" class="btn btn-secondary">Back</a>

</form>