@model StudentManagementSystem.Models.Student

<h2>Add Student</h2>

<form asp-action="Create">

	<div class="form-group">
		<label>Student Name</label>
		<input asp-for="StudentName" class="form-control" placeholder="Enter student name" />
	</div>

	<div class="form-group">
		<label>Email</label>
		<input asp-for="Email" class="form-control" placeholder="Enter student email" />
	</div>

	<div class="form-group">
		<label>Phone Number</label>
		<input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
	</div>

	<div class="form-group">
		<label>Address</label>
<textarea asp-for="Address" class="form-control" placeholder="Enter student address"></textarea>
	</div>

	<div class="form-group">
		<label>Select Department</label>
		<select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-control"></select>
	</div>

	<div class="form-group">
		<label>Select Course</label>
		<select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-control"></select>
	</div>

	<br />

	<button type="submit" class="btn btn-primary">Add Student</button>

	<a asp-action="Index" class="btn btn-secondary">Back</a>

</form>